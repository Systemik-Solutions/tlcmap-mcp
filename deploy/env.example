# tlcmap-mcp environment. Install as /etc/tlcmap-mcp/env (root:tlcmap-mcp, 0640).
# Each line shows the default except PUBLIC_URL, which has none and is required.

# Interface to bind. Keep 127.0.0.1: Apache is the only public entry point.
HOST=127.0.0.1
# TCP port to listen on (1-65535). The Apache vhost proxies to this port.
PORT=3100
# Public base URL; its hostname must match the vhost ServerName (Host validation admits only it).
PUBLIC_URL=https://test-mcp.tlcmap.org
# TLCMap instance to read from (absolute URL).
TLCMAP_BASE_URL=https://tlcmap.org
# Enabled tool scopes, comma list. Only "read" is accepted in A0.
TLCMAP_MCP_SCOPES=read
# Log level: debug, info, warn or error.
LOG_LEVEL=info
# Requests per minute allowed to /mcp (rate limit) (integer, 1 or more).
RATE_LIMIT_PER_MIN=60
# Concurrent upstream requests to TLCMap (integer, 1 or more).
UPSTREAM_CONCURRENCY=4
# Upstream requests allowed to wait for a slot before new ones are refused (1 or more).
UPSTREAM_QUEUE_MAX=20
# Longest a request waits in the upstream queue, in milliseconds (1 or more).
UPSTREAM_QUEUE_TIMEOUT_MS=20000
# Upstream request timeout, in milliseconds (1 or more).
UPSTREAM_TIMEOUT_MS=60000
# Largest upstream response accepted, in bytes (1 or more). Default is 64 MiB.
UPSTREAM_MAX_BYTES=67108864
# Response cache size limit, in bytes. Must be at least UPSTREAM_MAX_BYTES. Default is 1 GiB.
CACHE_MAX_BYTES=1073741824
# Response cache lifetime, in seconds (1 or more).
CACHE_TTL_S=3600
